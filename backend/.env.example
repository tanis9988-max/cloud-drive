# Server
PORT=5000
JWT_SECRET=change_this_to_a_long_random_string

# PostgreSQL
DATABASE_URL=postgres://clouddrive:clouddrive@localhost:5432/clouddrive

# Storage: "local" (default, saves to disk) or "s3" (real AWS S3)
STORAGE_DRIVER=local

# Only needed if STORAGE_DRIVER=s3
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=clouddrive-uploads
